root_folder: {{ data_folder }}/{{ corpus_version }}
data_folder: {{ data_folder }}/{{ corpus_version }}
version: {{ corpus_version }}

corpus:
  version: {{ corpus_version }}
  folder: {{ data_folder }}/{{ corpus_version }}/parlaclarin/protocols
  pattern: "**/prot-*-*.xml"
  github:
    user: swerik-project
    repository: riksdagen-records
    path: data
    local_folder: {{ data_folder }}/{{ corpus_version }}/parlaclarin/protocols

metadata:
  version: {{ metadata_version }}
  folder: {{ data_folder }}/{{ metadata_version }} }}/parlaclarin/metadata
  database:
    type: pyriksprot.metadata.database.SqliteDatabase
    options:
      filename: {{ data_folder }}/{{ metadata_version }} }}/riksprot_metadata.db

  github:
    user: swerik-project
    repository: riksdagen-persons
    path: data
    url: https://github.com/swerik-project/riksdagen-records.git

tagged_frames:
  folder: {{ data_folder }}/{{ corpus_version }}/tagged_frames
  file_pattern: prot-*.zip
  pattern: {{ data_folder }}/{{ corpus_version }}/tagged_frames/**/prot-*.zip

tagged_speeches:
  folder: {{ data_folder }}/{{ corpus_version }}/tagged_frames_speeches.feather

dehyphen:
  folder: {{ data_folder }}/{{ corpus_version }}/dehyphen
  tf_filename: {{ data_folder }}/{{ corpus_version }}/dehyphen/word-frequencies.pkl

tagger:
  module: pyriksprot_tagger.taggers.stanza_tagger
  stanza_datadir: /data/sparv/models/stanza
  preprocessors: dedent,dehyphen,strip,pretokenize
  lang: "sv"
  processors: tokenize,lemma,pos
  tokenize_pretokenized: true
  tokenize_no_ssplit: true
  use_gpu: true
  num_threads: 1
